#!/usr/bin/env bash
#PBS -q auto_free
#PBS -j oe

set -euo pipefail

if [[ -f /etc/profile.d/modules.sh ]]; then
    source /etc/profile.d/modules.sh
fi
module load openmpi/gcc/64/4.1.8
mpi_prefix=$(dirname "$(dirname "$(command -v mpirun)")")

: "${PROJECT_DIR:?PROJECT_DIR must be supplied with qsub -v}"
: "${DATASET_KEY:?DATASET_KEY must name one of the four datasets}"
: "${TOTAL_CPUS:?TOTAL_CPUS must be 32 or 64}"

cd "$PROJECT_DIR"
case "$DATASET_KEY" in
    google)   dataset="data/processed/web-Google.prcsr" ;;
    berkstan) dataset="data/processed/web-BerkStan.prcsr" ;;
    enwiki)   dataset="data/processed/enwiki-2013.prcsr" ;;
    uk)       dataset="data/processed/uk-2002.prcsr" ;;
    *) echo "Unknown DATASET_KEY: $DATASET_KEY" >&2; exit 2 ;;
esac

case "$TOTAL_CPUS" in
    32)  mpi_config="32 1";  hybrid_config="4 8" ;;
    64)  mpi_config="64 1"; hybrid_config="8 8" ;;
    *) echo "Unsupported TOTAL_CPUS: $TOTAL_CPUS" >&2; exit 3 ;;
esac

program=./build/pagerank
repetitions=5
job_id=${PBS_JOBID%%.*}
output_dir="results/vanda/demand/raw"
mkdir -p "$output_dir" "results/vanda/demand/logs"
metrics_file="$output_dir/${job_id}-demand-${DATASET_KEY}-${TOTAL_CPUS}.csv"
node_count=$(sort -u "$PBS_NODEFILE" | wc -l | tr -d ' ')

run_case() {
    local ranks=$1
    local threads=$2
    local exchange=$3
    local record=$4
    local repetition=$5
    local config="${ranks}x${threads}"
    local mode=hybrid
    if (( threads == 1 )); then mode=mpi; fi
    if (( ranks % node_count != 0 )); then
        echo "Ranks ($ranks) must be divisible by nodes ($node_count)" >&2
        exit 4
    fi

    local ranks_per_node=$((ranks / node_count))
    export OMP_NUM_THREADS=$threads
    export OMP_PLACES=cores
    export OMP_PROC_BIND=spread
    local args=(
        "$program" --input "$dataset" --input-format csr
        --mode "$mode" --threads "$threads" --partition in-edges
        --score-exchange "$exchange" --top-k 0
        --run-id "demand-${DATASET_KEY}-${TOTAL_CPUS}-${config}-${exchange}-rep${repetition}"
    )
    if [[ "$record" == yes ]]; then args+=(--metrics "$metrics_file"); fi

    mpirun --prefix "$mpi_prefix" --hostfile "$PBS_NODEFILE" \
        --mca plm ^tm --mca ras ^tm --mca osc ^ucx \
        -np "$ranks" --map-by "ppr:${ranks_per_node}:node:PE=${threads}" \
        --bind-to core "${args[@]}"
}

echo "PBS job:      $PBS_JOBID"
echo "Dataset:      $dataset"
echo "Total CPUs:   $TOTAL_CPUS"
echo "Nodes:        $node_count"
echo "Partition:    in-edges"
echo "Metrics file: $metrics_file"

for config in "$mpi_config" "$hybrid_config"; do
    read -r ranks threads <<< "$config"
    for exchange in full demand; do
        echo "Warm-up: ${ranks}x${threads}, ${exchange}"
        run_case "$ranks" "$threads" "$exchange" no 0
        for repetition in $(seq 1 "$repetitions"); do
            echo "Measured run $repetition/$repetitions: ${ranks}x${threads}, ${exchange}"
            run_case "$ranks" "$threads" "$exchange" yes "$repetition"
        done
    done
done

echo "Completed: $metrics_file"
