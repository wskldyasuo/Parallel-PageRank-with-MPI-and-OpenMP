#!/usr/bin/env bash
#PBS -q auto_free
#PBS -j oe

set -euo pipefail

if [[ -f /etc/profile.d/modules.sh ]]; then
    # PBS starts a non-interactive shell; initialise Environment Modules explicitly.
    source /etc/profile.d/modules.sh
fi
module load openmpi/gcc/64/4.1.8
mpi_prefix=$(dirname "$(dirname "$(command -v mpirun)")")

: "${PROJECT_DIR:?PROJECT_DIR must be supplied with qsub -v}"
: "${SUITE:?SUITE must be fixed32 or strong}"
: "${DATASET_KEY:?DATASET_KEY must name one of the four datasets}"

cd "$PROJECT_DIR"

case "$DATASET_KEY" in
    google)   dataset="data/processed/web-Google.prcsr" ;;
    berkstan) dataset="data/processed/web-BerkStan.prcsr" ;;
    enwiki)   dataset="data/processed/enwiki-2013.prcsr" ;;
    uk)       dataset="data/processed/uk-2002.prcsr" ;;
    *) echo "Unknown DATASET_KEY: $DATASET_KEY" >&2; exit 2 ;;
esac

program=./build/pagerank
repetitions=5
job_id=${PBS_JOBID%%.*}
output_dir="results/vanda/raw"
mkdir -p "$output_dir" "results/vanda/logs"

node_count=$(sort -u "$PBS_NODEFILE" | wc -l | tr -d ' ')

run_parallel() {
    local mode=$1
    local ranks=$2
    local threads=$3
    local config=$4
    local record=$5
    local repetition=$6

    if (( ranks % node_count != 0 )); then
        echo "Ranks ($ranks) must be divisible by allocated nodes ($node_count)" >&2
        exit 3
    fi

    local ranks_per_node=$((ranks / node_count))
    export OMP_NUM_THREADS=$threads
    export OMP_PLACES=cores
    export OMP_PROC_BIND=spread

    local args=(
        "$program"
        --input "$dataset"
        --input-format csr
        --mode "$mode"
        --threads "$threads"
        --top-k 0
        --run-id "${SUITE}-${DATASET_KEY}-${config}-rep${repetition}"
    )
    if [[ "$record" == yes ]]; then
        args+=(--metrics "$metrics_file")
    fi

    mpirun --prefix "$mpi_prefix" --hostfile "$PBS_NODEFILE" \
        --mca plm ^tm --mca ras ^tm --mca osc ^ucx \
        -np "$ranks" \
        --map-by "ppr:${ranks_per_node}:node:PE=${threads}" \
        --bind-to core \
        "${args[@]}"
}

run_serial() {
    local config=$1
    local record=$2
    local repetition=$3
    local args=(
        "$program"
        --input "$dataset"
        --input-format csr
        --mode serial
        --threads 1
        --top-k 0
        --run-id "${SUITE}-${DATASET_KEY}-${config}-rep${repetition}"
    )
    if [[ "$record" == yes ]]; then
        args+=(--metrics "$metrics_file")
    fi
    "${args[@]}"
}

run_config() {
    local ranks=$1
    local threads=$2
    local config="${ranks}x${threads}"
    local mode=hybrid
    if (( ranks == 1 && threads == 1 )); then
        mode=serial
    elif (( threads == 1 )); then
        mode=mpi
    fi

    echo "Warm-up: suite=$SUITE dataset=$DATASET_KEY config=$config mode=$mode"
    if [[ "$mode" == serial ]]; then
        run_serial "$config" no 0
    else
        run_parallel "$mode" "$ranks" "$threads" "$config" no 0
    fi

    for repetition in $(seq 1 "$repetitions"); do
        echo "Measured run $repetition/$repetitions: $config"
        if [[ "$mode" == serial ]]; then
            run_serial "$config" yes "$repetition"
        else
            run_parallel "$mode" "$ranks" "$threads" "$config" yes "$repetition"
        fi
    done
}

metrics_file="$output_dir/${job_id}-${SUITE}-${DATASET_KEY}.csv"

echo "PBS job:       $PBS_JOBID"
echo "Suite:         $SUITE"
echo "Dataset:       $dataset"
echo "Nodes:         $node_count"
echo "Node list:     $(sort -u "$PBS_NODEFILE" | tr '\n' ' ')"
echo "Metrics file:  $metrics_file"

if [[ "$SUITE" == fixed32 ]]; then
    for config in "1 32" "2 16" "4 8" "8 4" "16 2" "32 1"; do
        read -r ranks threads <<< "$config"
        run_config "$ranks" "$threads"
    done
elif [[ "$SUITE" == strong ]]; then
    : "${TOTAL_CPUS:?TOTAL_CPUS is required for the strong suite}"
    case "$TOTAL_CPUS" in
        1)   run_config 1 1 ;;
        2)   run_config 2 1;  run_config 1 2 ;;
        4)   run_config 4 1;  run_config 2 2 ;;
        8)   run_config 8 1;  run_config 2 4 ;;
        16)  run_config 16 1; run_config 4 4 ;;
        32)  run_config 32 1; run_config 4 8 ;;
        64)  run_config 64 1; run_config 8 8 ;;
        128) run_config 128 1; run_config 16 8 ;;
        *) echo "Unsupported TOTAL_CPUS: $TOTAL_CPUS" >&2; exit 4 ;;
    esac
else
    echo "Unknown SUITE: $SUITE" >&2
    exit 5
fi

echo "Completed: $metrics_file"
