#!/usr/bin/env bash
#PBS -q auto_free
#PBS -j oe

set -euo pipefail

if [[ -f /etc/profile.d/modules.sh ]]; then
    source /etc/profile.d/modules.sh
fi
module load openmpi/gcc/64/4.1.8
mpi_prefix=$(dirname "$(dirname "$(command -v mpirun)")")

: "${PROJECT_DIR:?PROJECT_DIR must be supplied with qsub -v}"
: "${DATASET_KEY:?DATASET_KEY must name one of the four datasets}"
: "${SWEEP_SCOPE:?SWEEP_SCOPE must be single, 64, or 128}"

cd "$PROJECT_DIR"

case "$DATASET_KEY" in
    google)   dataset="data/processed/web-Google.prcsr" ;;
    berkstan) dataset="data/processed/web-BerkStan.prcsr" ;;
    enwiki)   dataset="data/processed/enwiki-2013.prcsr" ;;
    uk)       dataset="data/processed/uk-2002.prcsr" ;;
    *) echo "Unknown DATASET_KEY: $DATASET_KEY" >&2; exit 2 ;;
esac

case "$SWEEP_SCOPE" in
    single) cpu_counts=(1 2 4 8 16 32) ;;
    64)     cpu_counts=(64) ;;
    128)    cpu_counts=(128) ;;
    *) echo "Unknown SWEEP_SCOPE: $SWEEP_SCOPE" >&2; exit 3 ;;
esac

program=./build/pagerank
repetitions=5
job_id=${PBS_JOBID%%.*}
output_dir="results/vanda/strong_full/raw"
metrics_file="$output_dir/${job_id}-strong-full-${DATASET_KEY}-${SWEEP_SCOPE}.csv"
mkdir -p "$output_dir" "results/vanda/strong_full/logs"

node_count=$(sort -u "$PBS_NODEFILE" | wc -l | tr -d ' ')

run_serial() {
    local record=$1 repetition=$2
    local args=(
        "$program" --input "$dataset" --input-format csr
        --mode serial --threads 1 --partition vertices --score-exchange full
        --top-k 0 --run-id "strongfull-${DATASET_KEY}-1-1x1-rep${repetition}"
    )
    [[ "$record" == yes ]] && args+=(--metrics "$metrics_file")
    "${args[@]}"
}

run_parallel() {
    local cpus=$1 ranks=$2 threads=$3 record=$4 repetition=$5
    local mode=hybrid
    (( threads == 1 )) && mode=mpi
    local ranks_per_node=$((ranks / node_count))
    export OMP_NUM_THREADS=$threads
    export OMP_PLACES=cores
    export OMP_PROC_BIND=spread
    local args=(
        "$program" --input "$dataset" --input-format csr
        --mode "$mode" --threads "$threads" --partition vertices --score-exchange full
        --top-k 0 --run-id "strongfull-${DATASET_KEY}-${cpus}-${ranks}x${threads}-rep${repetition}"
    )
    [[ "$record" == yes ]] && args+=(--metrics "$metrics_file")
    mpirun --prefix "$mpi_prefix" --hostfile "$PBS_NODEFILE" \
        --mca plm ^tm --mca ras ^tm --mca osc ^ucx \
        -np "$ranks" --map-by "ppr:${ranks_per_node}:node:PE=${threads}" \
        --bind-to core "${args[@]}"
}

measure_config() {
    local cpus=$1 ranks=$2 threads=$3
    echo "Warm-up: cpus=$cpus layout=${ranks}x${threads}"
    if (( cpus == 1 )); then
        run_serial no 0
    else
        run_parallel "$cpus" "$ranks" "$threads" no 0
    fi
    for repetition in $(seq 1 "$repetitions"); do
        echo "Measured run $repetition/$repetitions: cpus=$cpus layout=${ranks}x${threads}"
        if (( cpus == 1 )); then
            run_serial yes "$repetition"
        else
            run_parallel "$cpus" "$ranks" "$threads" yes "$repetition"
        fi
    done
}

echo "PBS job:      $PBS_JOBID"
echo "Dataset:      $dataset"
echo "Scope:        $SWEEP_SCOPE"
echo "Nodes:        $node_count"
echo "Metrics file: $metrics_file"

for cpus in "${cpu_counts[@]}"; do
    if (( cpus == 1 )); then
        measure_config 1 1 1
        continue
    fi
    for threads in 32 16 8 4 2 1; do
        (( cpus % threads == 0 )) || continue
        ranks=$((cpus / threads))
        (( ranks % node_count == 0 )) || continue
        measure_config "$cpus" "$ranks" "$threads"
    done
done

echo "Completed: $metrics_file"
